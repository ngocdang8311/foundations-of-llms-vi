---
// Kết quả kỳ vọng mà người học nên nhận được.
import Fold from "./Fold.astro";
import { fragment } from "./exercises";
const { nb } = Astro.props as { nb?: string };
const Content = nb ? fragment(nb, "checkpoint")?.default : null;
---
<Fold kind="checkpoint" label="Điểm kiểm tra" detail="kết quả bạn cần đạt được">
  <slot />
  {Content && <div class="exercise__outputs"><Content /></div>}
</Fold>
