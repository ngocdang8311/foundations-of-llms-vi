---
// Lời giải của một bài tập.
import Fold from "./Fold.astro";
import Missing from "./Missing.astro";
import { fragment } from "./exercises";
const { nb } = Astro.props as { nb: string };
const mod = fragment(nb, "solution");
const Content = mod?.default;
const detail = mod ? `${mod.cells} ô mã` : undefined;
---
<Fold kind="solution" label="Lời giải" detail={detail}>
  <p class="exercise__solution-note">Chạy các ô mã theo đúng thứ tự này trong một notebook mới: chúng đã bao gồm các lệnh import, bước tải dữ liệu và khởi tạo hạt giống ngẫu nhiên (random seed).</p>
  {Content ? <Content /> : <Missing notebook={nb} part="lời giải" />}
</Fold>
